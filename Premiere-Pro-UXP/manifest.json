{
  "manifestVersion": 5,
  "id": "com.codex.mambotts.premiere.v112",
  "name": "MamboTTS 配音台",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "mamboTtsPanel",
      "label": {
        "default": "MamboTTS 配音台"
      },
      "minimumSize": {
        "width": 280,
        "height": 500
      },
      "maximumSize": {
        "width": 1100,
        "height": 1800
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 850
      },
      "preferredFloatingSize": {
        "width": 400,
        "height": 900
      }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "network": {
      "domains": "all"
    },
    "launchProcess": {
      "schemes": [
        "file"
      ],
      "extensions": [
        ".exe"
      ]
    },
    "allowCodeGenerationFromStrings": false
  }
}
